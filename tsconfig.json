{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"rootDir": "src",
		"outDir": "dist",
		"noEmitOnError": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": false,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"sourceMap": true,
		"strict": true,
		"strictNullChecks": false,
		"useUnknownInCatchVariables": false,
		"noImplicitAny": false
	},
	"include": ["src/**/*.ts"]
}
